# Dependencies
node_modules/
.npm

# Logs
*.log
npm-debug.log*

# OS / editors
.DS_Store
.vscode/
.idea/
*.sublime-workspace

# Runtime data
*.pid
*.pid.lock

# Environments: only local.json (no secrets) and examples are tracked
web-app/env/*
!web-app/env/local.json
!web-app/env/*.example.json

# Certificates from Let's Encrypt (web-app/ssl is mounted as /etc/letsencrypt)
web-app/ssl/*
!web-app/ssl/cert.tmp.pem
!web-app/ssl/key.tmp.pem
web-app/.well-known/acme-challenge/*
!web-app/.well-known/acme-challenge/.gitkeep

# Deploy configuration (server addresses, local key paths)
deploy/*.conf

# Misc tooling
.env
.env.*
!.env.example
.eslintcache
coverage/
*.tgz

# Server-specific compose overrides (written by bootstrap.sh)
docker-compose.override.yml
