{
  "library": "html",
  "title": "HTML",
  "docs": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element",
  "groups": {
    "global": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "class",
        "type": "string"
      },
      {
        "name": "style",
        "type": "css",
        "description": "Inline CSS"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "hidden",
        "type": "boolean"
      }
    ],
    "ehtml-binding": [
      {
        "name": "data-text",
        "type": "expression",
        "placeholder": "${item.title}",
        "description": "Text content from an expression (any attribute with ${…} is evaluated, this is the element)"
      },
      {
        "name": "data-inner-html",
        "type": "expression",
        "description": "Html content from an expression (EHTML)"
      },
      {
        "name": "data-value",
        "type": "expression",
        "description": "Value of a field from an expression (EHTML)"
      },
      {
        "name": "data-checked",
        "type": "expression",
        "description": "Checked state from an expression (checkbox inputs)"
      },
      {
        "name": "data-disabled",
        "type": "expression",
        "description": "Disabled state from an expression (input, select, textarea, button)"
      },
      {
        "name": "data-internal-state",
        "type": "expression",
        "description": "Object stored as element.internalState (EHTML)"
      },
      {
        "name": "data-click-on-enter",
        "type": "boolean",
        "description": "Click when Enter is pressed (works without ${})"
      },
      {
        "name": "onclick",
        "type": "actions",
        "description": "Click handler"
      },
      {
        "name": "data-attributes-to-ignore",
        "type": "string",
        "description": "Comma-separated attributes EHTML must not evaluate"
      },
      {
        "name": "data-no-ehtml",
        "type": "enum",
        "values": [
          "true"
        ],
        "description": "EHTML skips this element and its children"
      },
      {
        "name": "data-src",
        "type": "expression",
        "description": "src from an expression (img, audio, video, iframe, source, script, input, embed, track)"
      }
    ],
    "field": [
      {
        "name": "name",
        "type": "string",
        "description": "Name in the request body of e-form (not needed for direct children of e-form-array)"
      },
      {
        "name": "placeholder",
        "type": "string"
      },
      {
        "name": "required",
        "type": "boolean"
      },
      {
        "name": "disabled",
        "type": "boolean"
      },
      {
        "name": "data-validation-pattern",
        "type": "string",
        "placeholder": "email",
        "description": "Regexp or one of: date, dateTime, email, month, number, password, tel, time, url (e-form)"
      },
      {
        "name": "data-validation-bad-format-error-message",
        "type": "string",
        "description": "Message when the value doesn't match the pattern (e-form)"
      },
      {
        "name": "data-validation-absence-error-message",
        "type": "string",
        "description": "Message when the required value is empty (e-form)"
      },
      {
        "name": "data-is-query-param",
        "type": "boolean",
        "description": "Send as a query param instead of body (e-form)"
      },
      {
        "name": "data-ignore",
        "type": "boolean",
        "description": "Don't send this field (e-form)"
      },
      {
        "name": "value",
        "type": "string"
      },
      {
        "name": "data-validation-min-files-number",
        "type": "string",
        "description": "Minimum number of files (file inputs, e-form)"
      },
      {
        "name": "data-validation-error-class-for-element",
        "type": "string",
        "description": "Class added to this field on error (e-form)"
      },
      {
        "name": "data-validation-error-class-for-message-box",
        "type": "string",
        "description": "Class of the error message box (e-form)"
      },
      {
        "name": "data-unchecked-value",
        "type": "string",
        "description": "Value sent when checkbox is not checked (e-form)"
      },
      {
        "name": "data-read-progress-bar",
        "type": "selector",
        "description": "Selector of a <progress> for reading files (e-form)"
      }
    ]
  },
  "elements": [
    {
      "id": "text-node",
      "name": "Text",
